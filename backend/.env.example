# Copy to .env (git-ignored) and fill in. The app will not start with required values missing.
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# Signs the OAuth state cookie. At least 32 characters. Generate: openssl rand -hex 32
SECRET_KEY=

# GitHub App (Settings > Developer settings > GitHub Apps). See README.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must exactly match the "Authorization callback URL" registered on the OAuth App.
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Where the browser app is served; users return here after sign-in.
FRONTEND_URL=http://localhost:5173

# Optional (defaults shown)
# COOKIE_SECURE=true
# ENABLE_DOCS=false   # set true locally to get Swagger UI at /docs
# SESSION_TTL_SECONDS=604800
