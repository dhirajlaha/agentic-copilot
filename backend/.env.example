# Copy to .env (git-ignored) and fill in. The app will not start with required values missing.
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# Signs the OAuth state cookie. At least 32 characters. Generate: openssl rand -hex 32
SECRET_KEY=

# GitHub App (Settings > Developer settings > GitHub Apps). See README.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must exactly match the "Callback URL" registered on the GitHub App. Also used for the
# installation check (sign-in round trip). Setup URL on the app: http://localhost:8000/repos/installed
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Repo access: the last part of https://github.com/apps/<slug>, and the app's private key
# file (generate it on the app's page; keep it OUTSIDE the repo, never commit it).
# The JWT is signed with GITHUB_CLIENT_ID, so the numeric App ID is not needed.
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=

# Where the browser app is served; users return here after sign-in.
FRONTEND_URL=http://localhost:5173

# Optional (defaults shown)
# COOKIE_SECURE=true
# ENABLE_DOCS=false   # set true locally to get Swagger UI at /docs
# SESSION_TTL_SECONDS=172800   # 2 days from sign-in

# ---- LLM used by the agents (not needed to start the API) ----
# One of: anthropic | bedrock | foundry | openai | gemini
#   anthropic : Claude API                      -> LLM_API_KEY
#   bedrock   : Claude on Amazon Bedrock        -> AWS_REGION + AWS credentials (env/profile/IAM role);
#               model ids are prefixed, e.g. anthropic.claude-opus-5-5
#   foundry   : Claude on Microsoft Foundry     -> LLM_API_KEY + FOUNDRY_RESOURCE
#   gemini    : Google Gemini (native API)              -> LLM_API_KEY, LLM_MODEL e.g. gemini-3.8-flash
#   openai    : OpenAI or any OpenAI-compatible endpoint -> LLM_API_KEY (+ LLM_BASE_URL):
#               Azure OpenAI  https://<resource>.openai.azure.com/openai/v1/
#               vLLM (week 8) http://localhost:8001/v1
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
# LLM_BASE_URL=
# AWS_REGION=
# FOUNDRY_RESOURCE=
# LLM_MAX_OUTPUT_TOKENS=16000
# LLM_TIMEOUT_SECONDS=300
# LLM_MAX_RETRIES=2

# ---- Code index (embeddings of the connected repository) ----
# Only Gemini today. The key falls back to LLM_API_KEY, so a Gemini user sets nothing extra.
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001
# Must equal the database column size (768). Changing it needs a migration and a re-index.
# EMBEDDING_DIMENSIONS=768
# Texts per request, and the estimated-token budget per request. Keep the budget below your
# provider's per-minute token quota (Gemini free tier: 30000).
# EMBEDDING_BATCH_SIZE=64
# EMBEDDING_MAX_BATCH_TOKENS=20000
# How many times to wait out a 429 ("retry in N seconds") before failing the run.
# EMBEDDING_RATE_LIMIT_RETRIES=6

# ---- Run worker (uv run python -m app.worker) ----
# WORKER_POLL_INTERVAL_SECONDS=2
# A running run must be renewed within this many seconds (renewed after every agent step).
# RUN_LEASE_SECONDS=1200
# LOG_LEVEL=INFO
