# Copy to .env (git-ignored) and fill in. The app will not start with required values missing.
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# Signs the OAuth state cookie. At least 32 characters. Generate: openssl rand -hex 32
SECRET_KEY=

# GitHub App (Settings > Developer settings > GitHub Apps). See README.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must exactly match the "Authorization callback URL" registered on the OAuth App.
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Where the browser app is served; users return here after sign-in.
FRONTEND_URL=http://localhost:5173

# Optional (defaults shown)
# COOKIE_SECURE=true
# ENABLE_DOCS=false   # set true locally to get Swagger UI at /docs
# SESSION_TTL_SECONDS=604800

# ---- LLM used by the agents (not needed to start the API) ----
# One of: anthropic | bedrock | foundry | openai
#   anthropic : Claude API                      -> LLM_API_KEY
#   bedrock   : Claude on Amazon Bedrock        -> AWS_REGION + AWS credentials (env/profile/IAM role);
#               model ids are prefixed, e.g. anthropic.claude-opus-5-5
#   foundry   : Claude on Microsoft Foundry     -> LLM_API_KEY + FOUNDRY_RESOURCE
#   openai    : OpenAI or any OpenAI-compatible endpoint -> LLM_API_KEY (+ LLM_BASE_URL):
#               Azure OpenAI  https://<resource>.openai.azure.com/openai/v1/
#               Gemini        https://generativelanguage.googleapis.com/v1beta/openai/
#               vLLM (week 8) http://localhost:8001/v1
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
# LLM_BASE_URL=
# AWS_REGION=
# FOUNDRY_RESOURCE=
# LLM_MAX_OUTPUT_TOKENS=16000
# LLM_TIMEOUT_SECONDS=300
# LLM_MAX_RETRIES=2

# ---- Run worker (uv run python -m app.worker) ----
# WORKER_POLL_INTERVAL_SECONDS=2
# A running run must be renewed within this many seconds (renewed after every agent step).
# RUN_LEASE_SECONDS=1200
# LOG_LEVEL=INFO
